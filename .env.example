# Local development defaults. Replace every credential before production deployment.
POSTGRES_USER=mfc
POSTGRES_PASSWORD=mfc_dev_password
POSTGRES_DB=mfc
DATABASE_URL=postgresql+psycopg://mfc:mfc_dev_password@db:5432/mfc
REDIS_URL=redis://redis:6379/0

APP_ENV=development
APP_LOG_LEVEL=INFO
JWT_SECRET=development-only-jwt-secret-replace-before-production
BOT_INTERNAL_API_TOKEN=development-only-internal-token
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

PUBLIC_API_URL=http://localhost:8000
PUBLIC_ADMIN_URL=http://localhost:5173
PUBLIC_WEBAPP_URL=http://localhost:5174
PUBLIC_WEBHOOK_BASE_URL=http://localhost:8080
PUBLIC_MINIAPP_URL=http://localhost:5174
DEFAULT_BOT_SLUG=default

BOT_MODE=live
BOT_SUPERVISOR_INTERVAL_SECONDS=10
BOT_RUNTIME_VERSION=local
BOT_MANAGED_ENV_FILE=/app/secrets/bots.env

# The default instance uses this variable unless another name is configured in the admin panel.
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=

# First platform administrator, created or updated on every backend start when both are set.
# Further administrators join through invite links from the admin panel.
BOOTSTRAP_ADMIN_MAX_ID=
BOOTSTRAP_ADMIN_FULL_NAME=

# Load demo bots, forms, FAQ, a test and synthetic activity on start (idempotent).
DEMO_SEED=true
# MAX ID of the demo staff member who processes requests in the main demo bot.
DEMO_STAFF_MAX_ID=demo-staff

# After issuing a per-bot runtime token in the admin panel, put it in
# BOT_RUNTIME_TOKEN_<NORMALIZED_SLUG>, for example:
# BOT_RUNTIME_TOKEN_DEFAULT=
# BOT_RUNTIME_TOKEN_HR=
# Webhook mode additionally requires one secret per slug:
# BOT_WEBHOOK_SECRET_DEFAULT=
# BOT_WEBHOOK_SECRET_HR=

DEV_BYPASS_INITDATA=true
GOOGLE_SHEETS_MODE=mock

# rut_schedule capability's data source. Default "miit_web" scrapes the university's public
# timetable site -- only ever from the nightly worker job (~02:00 Moscow time), never live on a
# user's request (see backend/app/modules/capabilities/rut_schedule/infrastructure/sync_worker.py).
# Once Oracle DB read access exists, fill in the three values below and flip
# RUT_SCHEDULE_PROVIDER=oracle yourself in this file (or the real deployment's env) -- there is no
# admin-panel toggle for this, it's a one-line edit here. The real query still needs to be written
# into backend/app/modules/capabilities/rut_schedule/infrastructure/oracle_provider.py (two
# NotImplementedError stubs marked TODO(oracle-schema)) once the actual table/view names are known.
RUT_SCHEDULE_PROVIDER=miit_web
# DSN shape: host:port/service_name (e.g. oracle-host.internal:1521/ORCLPDB1)
RUT_SCHEDULE_ORACLE_DSN=
RUT_SCHEDULE_ORACLE_USER=
RUT_SCHEDULE_ORACLE_PASSWORD=
